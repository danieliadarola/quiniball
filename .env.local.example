# Copia este fichero a `.env.local` y rellena con los valores de tu proyecto Supabase.

# Públicos (cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privados (solo servidor) — NO exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=
# Secreto JWT del proyecto Supabase (Settings > API > JWT Secret).
# Se usa para firmar nuestros tokens email+PIN de forma que RLS los acepte.
SUPABASE_JWT_SECRET=

# football-data.org — calendario y resultados del Mundial 2026 (competición WC).
# Token gratuito en https://www.football-data.org/client/register
# Lo usan scripts/import-fixtures.mjs (calendario) y la sincronización de resultados.
FOOTBALLDATA_TOKEN=
